{
  "id": "daybreak-planner-web",
  "name": "Daybreak Planner",
  "short_name": "Daybreak",
  "description": "Turn a task summary into a timed daily schedule with reminders.",
  "start_url": "./index.html#day",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F2F4F9",
  "theme_color": "#F2F4F9",
  "categories": [
    "productivity",
    "education"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Day",
      "short_name": "Day",
      "url": "./index.html#day",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add tasks",
      "short_name": "Add",
      "url": "./index.html#add",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Function",
      "short_name": "Function",
      "url": "./index.html#function",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
